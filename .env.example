# Postgres from docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5433/brain

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# LLM_SEED=7

# "openai" or "hash" (offline lexical embedder, no API key needed).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the VECTOR(n) column size created by the migration.
EMBEDDING_DIM=1536

CHUNK_MAX_TOKENS=400

# Experiment B (ontology-constrained extraction). JSON lists; empty = dynamic.
# ALLOWED_ENTITY_TYPES=["Drug","Gene","Protein","Mutation","Disease","ClinicalTrial","Organization","RegulatoryAgency"]
# ALLOWED_RELATIONSHIP_TYPES=["targets","inhibits","developed_by","evaluated_in","approved_for","studied_in","sponsored_by","subtype_of","variant_of","combined_with"]

# Entity resolution thresholds.
RESOLUTION_FUZZY_ENABLED=true
RESOLUTION_FUZZY_THRESHOLD=92
RESOLUTION_EMBEDDING_ENABLED=false

# Relationship validation.
ALLOW_SELF_RELATIONSHIPS=false
EVIDENCE_MIN_GROUNDING=90
EVIDENCE_REQUIRE_ENDPOINTS_IN_QUOTE=false
# RELATIONSHIP_TYPE_INVERSES={"targeted_by":"targets","developed":"developed_by"}
LLM_MAX_RETRIES=8
ATLAS_INTERNAL_DOMAINS=["northwind.io"]
