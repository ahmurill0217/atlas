# Postgres from docker-compose.yml (host port 5433).
DATABASE_URL=postgresql+psycopg://brain:brain@localhost:5433/brain

# Your own email domains: people on them are internal.
ATLAS_INTERNAL_DOMAINS=["northwind.io"]
# ATLAS_ONTOLOGY_DIR=ontology

# Answering (router classification, graph answers, brain answers).
OPENAI_API_KEY=
# ATLAS_ASK_MODEL=gpt-4o-mini

# brain (../brain): one OpenSearch index per Atlas database.
# ATLAS_BRAIN_INDEX=atlas_chunks
# ATLAS_BRAIN_OPENSEARCH_PORT=9201
# ATLAS_BRAIN_MODEL_SERVER_PORT=9100
